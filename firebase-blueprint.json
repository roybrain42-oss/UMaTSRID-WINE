{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account and profile information across citizen, collector, recycler, and admin roles.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user or Firebase Auth UID" },
        "name": { "type": "string", "description": "Full legal or display name" },
        "email": { "type": "string", "format": "email", "description": "Email address" },
        "phone": { "type": "string", "description": "Ghana phone number" },
        "role": { "type": "string", "enum": ["USER", "COMMUNITY_ADMIN", "COLLECTION_AGENT", "RECYCLER", "ADMIN"], "description": "Application permission role" },
        "entityType": { "type": "string", "enum": ["INDIVIDUAL", "SCHOOL", "COMMUNITY", "ORGANIZATION"], "description": "Entity classification" },
        "institutionName": { "type": "string", "description": "Associated institution or school name" },
        "location": { "type": "string", "description": "City or operational region in Ghana" },
        "community": { "type": "string", "description": "Local neighborhood or campus" },
        "ecoPoints": { "type": "number", "description": "Active reward point balance" },
        "totalWasteKg": { "type": "number", "description": "Cumulative waste diverted in kg" },
        "co2SavedKg": { "type": "number", "description": "Calculated carbon emissions saved in kg" },
        "verifiedCollections": { "type": "number", "description": "Count of scale-verified pickups" },
        "avatar": { "type": "string", "description": "Profile picture URL" },
        "authProvider": { "type": "string", "description": "Authentication provider: password, google, or biometric" },
        "googleId": { "type": "string", "description": "Firebase Google Auth UID" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account registration timestamp" }
      },
      "required": ["id", "name", "role", "ecoPoints"]
    },
    "WasteSubmission": {
      "title": "WasteSubmission",
      "description": "Citizen recyclable waste deposit and collection requests.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique submission identifier" },
        "userId": { "type": "string", "description": "Submitting citizen user ID" },
        "userName": { "type": "string", "description": "Citizen name" },
        "imageUrl": { "type": "string", "description": "Photo of sorted recyclables" },
        "userWeightEstimateKg": { "type": "number", "description": "User estimated weight" },
        "actualWeightKg": { "type": "number", "description": "Agent verified weight in kg" },
        "pointsAwarded": { "type": "number", "description": "EcoPoints awarded" },
        "status": { "type": "string", "enum": ["REQUESTED", "ACCEPTED", "POINTS_AWARDED", "CANCELLED"], "description": "Lifecycle state" },
        "pickupAddress": { "type": "string", "description": "Pickup street or GPS description" },
        "community": { "type": "string", "description": "Community or district" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Submission timestamp" }
      },
      "required": ["id", "userId", "status", "createdAt"]
    },
    "CollectionJob": {
      "title": "CollectionJob",
      "description": "Logistics and dispatch job for fleet collection agents.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Job identifier" },
        "submissionId": { "type": "string", "description": "Linked waste submission ID" },
        "userId": { "type": "string", "description": "Citizen user ID" },
        "userName": { "type": "string", "description": "Citizen name" },
        "wasteCategory": { "type": "string", "description": "Waste category (PLASTIC, METAL, PAPER, etc.)" },
        "material": { "type": "string", "description": "Specific material description" },
        "estimatedWeightKg": { "type": "number", "description": "Estimated weight in kg" },
        "actualWeightKg": { "type": "number", "description": "Agent digital scale verified weight" },
        "assignedAgentId": { "type": "string", "description": "Assigned collection agent UID" },
        "agentName": { "type": "string", "description": "Assigned agent name" },
        "status": { "type": "string", "enum": ["REQUESTED", "ACCEPTED", "POINTS_AWARDED", "CANCELLED"], "description": "Status of job" },
        "location": { "type": "string", "description": "Pickup location" },
        "community": { "type": "string", "description": "Community" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["id", "submissionId", "status", "createdAt"]
    },
    "PointTransaction": {
      "title": "PointTransaction",
      "description": "Double-entry financial and points ledger record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Transaction ID" },
        "userId": { "type": "string", "description": "Target account ID" },
        "type": { "type": "string", "description": "Transaction type" },
        "amount": { "type": "number", "description": "EcoPoints delta" },
        "balanceAfter": { "type": "number", "description": "Balance after transaction" },
        "description": { "type": "string", "description": "Human readable description" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Ledger entry timestamp" }
      },
      "required": ["id", "userId", "amount", "createdAt"]
    },
    "CashWithdrawal": {
      "title": "CashWithdrawal",
      "description": "Mobile Money cash out withdrawal record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Withdrawal identifier" },
        "userId": { "type": "string", "description": "Requesting citizen ID" },
        "amountGhs": { "type": "number", "description": "Ghana Cedi payout amount" },
        "ecoPointsDeducted": { "type": "number", "description": "Points debited" },
        "momoNumber": { "type": "string", "description": "Recipient MoMo number" },
        "network": { "type": "string", "description": "MTN, Telecel, or AT" },
        "status": { "type": "string", "enum": ["PENDING", "PROCESSING", "COMPLETED", "FAILED"], "description": "Payout status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Request timestamp" }
      },
      "required": ["id", "userId", "amountGhs", "ecoPointsDeducted", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Public and private user profiles."
    },
    "/submissions/{submissionId}": {
      "schema": "WasteSubmission",
      "description": "Citizen waste submission records."
    },
    "/collection_jobs/{jobId}": {
      "schema": "CollectionJob",
      "description": "Fleet dispatch and collection routes."
    },
    "/point_transactions/{txId}": {
      "schema": "PointTransaction",
      "description": "Points ledger transactions."
    },
    "/cash_withdrawals/{withdrawalId}": {
      "schema": "CashWithdrawal",
      "description": "MoMo cash out redemption logs."
    }
  }
}
